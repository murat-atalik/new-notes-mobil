# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# CocoaPods returns child-process output as ASCII-8BIT on some Ruby/macOS
# combinations. The repository path contains UTF-8 characters, so normalize
# command output before React Native's Hermes podspec combines it with paths.
Pod::Executable.singleton_class.class_eval do
  alias_method :execute_command_without_utf8, :execute_command

  def execute_command(*args)
    output = execute_command_without_utf8(*args)
    output.is_a?(String) ? output.dup.force_encoding(Encoding::UTF_8) : output
  end
end

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'NewNotesMobile' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build_configuration|
        deployment_target = build_configuration.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
        build_configuration.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] =
          [deployment_target.to_f, min_ios_version_supported.to_f].max.to_s
      end
    end
  end
end
